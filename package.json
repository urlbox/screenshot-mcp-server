{
  "name": "@urlbox/screenshot-mcp",
  "version": "2.0.0",
  "description": "Local stdio bridge to the hosted Urlbox MCP server: screenshots, PDFs, video, markdown and more from any website.",
  "mcpName": "io.github.urlbox/screenshot-mcp-server",
  "type": "module",
  "bin": {
    "screenshot-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "lint": "biome lint src/ test/",
    "lint:fix": "biome lint --write src/ test/",
    "format": "biome format --write src/ test/"
  },
  "keywords": [
    "mcp",
    "urlbox",
    "website",
    "url screenshot",
    "website capture",
    "capture",
    "puppeteer",
    "playwright",
    "url to image",
    "url to pdf",
    "full page",
    "full height",
    "model context protocol",
    "mcp server",
    "screenshot api"
  ],
  "author": "Urlbox Ltd. <support@urlbox.com>",
  "contributors": [
    {
      "name": "Arnold Cubici-Jones",
      "email": "arnold@urlbox.com"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/urlbox/screenshot-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urlbox/screenshot-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/urlbox/screenshot-mcp-server/issues",
    "email": "support@urlbox.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  }
}
